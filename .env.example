# =============================================================================
# CipherVault — Environment Configuration Template
# Copy this file to .env and fill in your own values.
# =============================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=ciphervault
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=ciphervault
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT Authentication ──────────────────────────────────────────────────────
JWT_SECRET_KEY=your_very_long_random_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Encryption ──────────────────────────────────────────────────────────────
MASTER_ENCRYPTION_KEY=your_64_char_hex_key_here

# ── Shamir Secret Sharing ──────────────────────────────────────────────────
SHAMIR_TOTAL_SHARES=5
SHAMIR_THRESHOLD=3

# ── File Settings ───────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=20
FILE_EXPIRY_HOURS=24
UPLOAD_DIR=/app/storage/uploads
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png

# ── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# ── Service URLs ───────────────────────────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:8001
DOCUMENT_SERVICE_URL=http://localhost:8002
ENCRYPTION_SERVICE_URL=http://localhost:8003
STORAGE_SERVICE_URL=http://localhost:8004
AUDIT_SERVICE_URL=http://localhost:8005

# ── API Gateway ─────────────────────────────────────────────────────────────
API_GATEWAY_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ── Celery ──────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Monitoring ──────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=your_admin_password

# ── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api
