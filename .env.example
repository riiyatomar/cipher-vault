# =============================================================================
# CipherVault — Environment Configuration Template
# Copy to .env and fill in your values.
# =============================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# Local development:
POSTGRES_USER=ciphervault
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=ciphervault
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Render production: these are auto-populated by render.yaml from the
# managed PostgreSQL instance. No manual configuration needed.

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# On Render free tier, skip Redis (rate limiting disabled):
# SKIP_REDIS=true
# On Render paid tier with Redis add-on:
# REDIS_URL=redis://red-xxxxx:6379

# ── JWT Authentication ──────────────────────────────────────────────────────
# IMPORTANT: Generate a strong secret for production!
# python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=your_very_long_random_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Encryption ──────────────────────────────────────────────────────────────
# 64-character hex string (256-bit key). Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
MASTER_ENCRYPTION_KEY=your_64_char_hex_key_here

# ── Shamir Secret Sharing ──────────────────────────────────────────────────
SHAMIR_TOTAL_SHARES=5
SHAMIR_THRESHOLD=3

# ── File Settings ───────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=20
FILE_EXPIRY_HOURS=24
# Local:
UPLOAD_DIR=./storage/uploads
# Render production (persistent disk):
# UPLOAD_DIR=/opt/render/project/storage/uploads
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png

# ── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ── Service URLs (local microservice mode only) ───────────────────────────
# These are NOT needed when using the unified server.py
AUTH_SERVICE_URL=http://localhost:8001
DOCUMENT_SERVICE_URL=http://localhost:8002
ENCRYPTION_SERVICE_URL=http://localhost:8003
STORAGE_SERVICE_URL=http://localhost:8004
AUDIT_SERVICE_URL=http://localhost:8005

# ── API Gateway ─────────────────────────────────────────────────────────────
API_GATEWAY_PORT=8000
# CORS: comma-separated list of allowed origins
# Local:
CORS_ORIGINS=http://localhost:3000
# Production (set to your Vercel URL):
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# ── Celery (optional, for background workers) ──────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Monitoring (optional) ──────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=your_admin_password

# ── Frontend ────────────────────────────────────────────────────────────────
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Production (Vercel): set via Vercel dashboard, not here.
# NEXT_PUBLIC_API_URL is optional — defaults to /api which uses Vercel rewrites.
# NEXT_PUBLIC_DEMO_MODE=false
